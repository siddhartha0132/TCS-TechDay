# Copy to .env and fill in. With no LLM key the app runs in deterministic mode.
# LLM: a direct Anthropic key, or an OpenRouter key (used when ANTHROPIC_API_KEY is empty)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Voice: Sarvam AI speech-to-text / text-to-speech (browser speech is used when empty)
SARVAM_API_KEY=
# Optional overrides (Anthropic-style IDs are mapped to OpenRouter IDs automatically)
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
