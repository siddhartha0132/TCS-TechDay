# Copy to .env and fill in. Every key is optional; with none, the rules engine answers everything.
# LLM chain: Claude (paid) -> OpenRouter free -> NVIDIA free -> more OpenRouter free -> rules engine
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Voice: Sarvam AI speech-to-text / text-to-speech (browser speech is used when empty)
SARVAM_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_TURN_BUDGET_S=13
